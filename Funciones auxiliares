def generar_linea(encabezados,linea):
    registro = {}
    for i in range(0,len(encabezados)):
        registro[encabezados[i]] = str(linea[i])
    return registro

def evaluar_tipo_de_dato(columna,tipo_dato):
    if tipo_dato == None or tipo_dato == "":
        if evaluar_booleano(columna):
            return convertir_booleano
        elif evaluar_int(columna):
            return int
        elif evaluar_float(columna):
            return float
        else:
            return str
    try:
        diccionario = {"bool": convertir_booleano, "int": int, "float": float, "str":str}
        return diccionario[tipo_dato]
    except KeyError:
        raise KeyError("Al menos uno de los tipos de datos proveídos no se coincide con las claves soportadas")
 
def evaluar_booleano(columna):
    for i in columna:
        if i.lower() == "true" or i.lower() == "false":
            continue
        else:
            return False
    return True

def convertir_booleano(string):
    if string.lower() == "true":
        return True
    if string.lower() == "false":
        return False 

def evaluar_float(columna):
    for i in columna:
        try: 
            float(i)
        except ValueError:
            return False
    return True

def evaluar_int(columna):
    for i in columna:
        try:
            int(i)
        except ValueError:
            return False
    return True
       
def convertir_columna(columna,funcion):
    nueva_columna = []
    for i in columna:
        nueva_columna.append(funcion(i))
    return nueva_columna

def determinar_separador(ruta,separador):
    if separador != None:
        SEPARADOR = separador
    else:
        extension = ruta.split(".")[-1]
        if extension == "csv":
            SEPARADOR = ";"
        elif extension == "tsv":
            SEPARADOR = "\t"
        elif extension == "psv":
            SEPARADOR = "|"
        else:
            print("No se especificó ningun separador ni se pudo inferir un separador válido, se tomará (,) como separador")
            SEPARADOR = ","
    return SEPARADOR


