def crear_encabezados(linea,numeros,nombres):
    lista_encabezados = []
    lista_original_acum = []
    lista_depurada = []
    for i in linea:
        if i == "":
            i = "unnamed"
        if i in lista_original_acum:
            lista_depurada.append(f"{i} {lista_original_acum.count(i) + 1}")
        else:
            lista_depurada.append(i)
        lista_original_acum.append(i)
    if numeros != None:
        for i in numeros:
            lista_encabezados.append(lista_depurada[i - 1])
    elif nombres != None:
        for i in nombres:
            lista_encabezados.append(lista_depurada[linea.index(i)])
    else:
        lista_encabezados = lista_depurada
    return lista_encabezados

