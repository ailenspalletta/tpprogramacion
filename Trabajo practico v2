import funciones_auxiliares_tp as f

# Definición de función principal
def crear_dataset(
    ruta, separador = None, tipo_columnas = None, nro_columnas_a_importar = None, nro_filas_a_importar = None, 
    nombres_columnas_a_importar = None, archivo_sin_encabezados = False):

    # Lectura del archivo según la ruta provista
    archivo = open(ruta,"r")

    # Determinación del separador, segun el valor provisto, si no se provee se infiere
    SEPARADOR = f.determinar_separador(ruta,separador)


    # Si el archivo tiene encabezados, se determinan en función de la primer linea 
    if archivo_sin_encabezados == False:
        primera_linea = archivo.readline().rstrip("\n").split(SEPARADOR)
        encabezados = f.crear_encabezados(primera_linea,nro_columnas_a_importar,nombres_columnas_a_importar)
        registros = []
    # Si el archivo NO tiene encabezados, se construyen. Adicionalmente, como se leyó la primer linea,
    # esta se incorpora a los registros si es necesario (no se puede volver a leer de nuevo)
    elif archivo_sin_encabezados == True:
        primera_linea = archivo.readline().rstrip("\n").split(SEPARADOR)
        encabezados = [f"encabezado {i}" for i in range(0,len(primera_linea))]
        registros = []
        if nro_filas_a_importar != None:
            if 1 in nro_filas_a_importar:
                registros.append(f.generar_linea(encabezados,primera_linea))
        else:
            registros.append(f.generar_linea(encabezados,primera_linea))


# El contador se establece en 2 porque la primer linea ya se evalúo anteriormente para construir los encabezados

    contador = 2

    # Si se especificaron lineas específicas a importar, se va verificando cuales leer y cuales no
    # Las lineas a leer se identifican como una lista numérica, NO como un rango. 
    # Esto es por si se quieren saltear lineas
    # Si no se especifica, se leen todas las lineas

    if nro_filas_a_importar != None:

        for linea in archivo:
            linea = linea.rstrip("\n").split(SEPARADOR) 
            if contador not in nro_filas_a_importar:
                contador += 1
                continue
            registros.append(f.generar_linea(encabezados,linea))
            contador += 1

    elif nro_filas_a_importar == None:
        for linea in archivo:
            linea = linea.rstrip("\n").split(SEPARADOR)
            registros.append(f.generar_linea(encabezados,linea))
    


    # Si no se pasó un argumento para tipos de columnas, se construye una lista de None

    if tipo_columnas == None:
        tipo_columnas_lista = [None for i in range(0,len(encabezados))]
    elif tipo_columnas != None:
        tipo_columnas_lista = tipo_columnas

    # Se construye una columna, luego se evalua a que tipo de dato necesita convertirse
    # Se toma como prioridad el argumento provisto por el usuario, si no, se evaluan los 
    # distintos tipos de datos y se asigna uno y se reconstruye la columna
    # Luego, se reescribe la columna convertida en la lista de registros

    for i,o in zip(encabezados,tipo_columnas_lista):
        columna = []
        for j in registros:
             columna.append(j[i])
        funcion_convertir_dato = f.evaluar_tipo_de_dato(columna,o)
        columna = f.convertir_columna(columna,funcion_convertir_dato)
        for k in registros:
            k[i] = columna[registros.index(k)]
    
    #codigo de prueba
    return encabezados,registros

a,b = crear_dataset("dataset_prueba.txt",separador = ",", archivo_sin_encabezados=False, nro_columnas_a_importar=[1,2,3])



